# ===========================================
# 支付系统配置 - 复制此文件为 .env 并填写真实参数
# ===========================================

# ==================== 支付宝配置 ====================
# 申请地址: https://open.alipay.com
# 沙箱测试: https://open.alipay.com/platform/appDaily.htm

# 支付宝应用APPID（格式：2021000112345678）
ALIPAY_APP_ID=2021000112345678

# 支付宝网关（生产用这个，沙箱用后面的）
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 沙箱模式（开发测试设为true，生产环境删除或设为false）
ALIPAY_SANDBOX=true

# 卖家PID/用户ID（在蚂蚁金服开放平台查看）
ALIPAY_SELLER_ID=2088123456789012

# 应用私钥（RSA2，必须用PKCS8格式）
# 生成方法：openssl genrsa -out app_private_key.pem 2048
#          openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in app_private_key.pem -out app_private_key_pkcs8.pem
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC6KQ8x...
替换为你自己的私钥内容...
-----END PRIVATE KEY-----"

# 支付宝公钥（用于验证回调签名，在支付宝开放平台下载）
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAyF...
替换为你自己的公钥内容...
-----END PUBLIC KEY-----"

# 支付成功回调地址（必须是HTTPS，生产环境必须可访问）
ALIPAY_NOTIFY_URL=https://yourdomain.com/api/payment/alipay/notify

# 支付完成跳转地址
ALIPAY_RETURN_URL=https://yourdomain.com/payment/success

# ==================== 微信支付配置 ====================
# 申请地址: https://pay.weixin.qq.com

WECHAT_APPID=wx1234567890abcdef
WECHAT_MCH_ID=1234567890
WECHAT_KEY=your_wechat_api_key_32_chars
WECHAT_NOTIFY_URL=https://yourdomain.com/api/payment/wechat/notify

# ==================== Stripe配置（国际用户）====================
# 申请地址: https://dashboard.stripe.com

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
